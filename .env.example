# Copiar a .env.local y llenar. .env.local NO se sube al repo.

# --- Supabase (frontend) ---------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (scripts de import, sólo local) ------------------------------
# service_role salta RLS: nunca ponerla en variables VITE_* ni en Vercel
# como pública.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (subida de imágenes desde el script de import) -------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=climazoe/productos
